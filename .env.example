# Server Port (fixed to 3000 in cloud environment)
PORT=3000

# Admin Auth Credentials (default seeded on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
JWT_SECRET=castloop_24x7_jwt_secret_key_change_in_production_32chars

# Storage Paths
UPLOAD_DIR=./data/uploads
DATA_DIR=./data

# Streaming Defaults
DEFAULT_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
MAX_UPLOAD_SIZE_MB=500
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional Gemini API Key & App URL
GEMINI_API_KEY=
APP_URL=
